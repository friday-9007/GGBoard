// ggBoard — Prisma schema (Prisma 6, classic client).
// Organizers and players are SEPARATE account tables. The old unified `users`
// table is gone. Team rosters live in `team_members` (was the old `players`).
// snake_case field names keep the JSON API contract identical.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Organizer accounts ───
model Organizer {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password_hash String
  display_name  String?
  created_at    DateTime @default(now())

  organized_games     Game[]       @relation("GameOrganizer")
  reviewed_submissions Submission[] @relation("SubmissionReviewer")

  @@map("organizers")
}

// ─── Player accounts (login + profile) ───
model Player {
  id               Int       @id @default(autoincrement())
  username         String    @unique
  password_hash    String
  display_name     String?
  email            String?
  phone            String?
  games            Json      @default(dbgenerated("'[]'::jsonb")) // [{ game, ign, uid, rank, role }]
  date_of_birth    DateTime? @db.Date
  country          String?
  city             String?
  gender           String?
  language         String?
  looking_for_team Boolean   @default(false)
  preferred_role   String?
  bio              String?
  created_at       DateTime  @default(now())

  led_teams   Team[]       @relation("TeamLeader")
  memberships TeamMember[] @relation("MemberAccount")
  uploads     Submission[] @relation("SubmissionUploader")

  @@map("players")
}

// ─── Games / tournaments ───
model Game {
  id                    Int       @id @default(autoincrement())
  game_title            String
  tournament_name       String
  status                String    @default("active")
  num_rounds            Int       @default(3) // set later (after registration closes), not at creation
  description           String?
  start_date            DateTime? // event start
  end_date              DateTime?
  registration_start    DateTime? // registration opens
  registration_deadline DateTime? // registration closes (extendable)
  team_limit            Int? // max registered teams; null = unlimited
  is_paid               Boolean   @default(false)
  entry_fee             Int? // per-team fee (whole currency units)
  prize_pool            String? // prize amount / value
  prize_type            String? // cash | gift_card | uc | other
  organizer_id          Int?
  created_at            DateTime  @default(now())

  organizer   Organizer?   @relation("GameOrganizer", fields: [organizer_id], references: [id], onDelete: Cascade)
  scores      Score[]
  submissions Submission[]

  @@map("games")
}

// ─── Teams (one game each; lasting roster) ───
model Team {
  id          Int      @id @default(autoincrement())
  team_name   String
  unique_code String   @unique
  game        String
  leader_id   Int?
  created_at  DateTime @default(now())

  leader      Player?      @relation("TeamLeader", fields: [leader_id], references: [id], onDelete: SetNull)
  members     TeamMember[]
  scores      Score[]
  submissions Submission[]

  @@map("teams")
}

// ─── Team roster entries ───
model TeamMember {
  id           Int      @id @default(autoincrement())
  full_name    String
  in_game_name String
  email        String?
  phone        String?
  team_id      Int
  player_id    Int?
  created_at   DateTime @default(now())

  team   Team    @relation(fields: [team_id], references: [id], onDelete: Cascade)
  player Player? @relation("MemberAccount", fields: [player_id], references: [id], onDelete: SetNull)

  @@map("team_members")
}

// ─── Scores (a row = a team's registration into a tournament) ───
model Score {
  id           Int      @id @default(autoincrement())
  team_id      Int
  game_id      Int
  round_scores Json     @default(dbgenerated("'[]'::jsonb"))
  total_score  Int      @default(0)
  updated_at   DateTime @default(now())

  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
  game Game @relation(fields: [game_id], references: [id], onDelete: Cascade)

  @@unique([team_id, game_id])
  @@map("scores")
}

// ─── Media submissions (gameplay verification) ───
model Submission {
  id           Int       @id @default(autoincrement())
  game_id      Int?
  team_id      Int?
  player_id    Int?
  kind         String
  purpose      String    @default("gameplay_verification")
  storage_path String
  status       String    @default("pending")
  reviewed_by  Int?
  note         String?
  created_at   DateTime  @default(now())
  reviewed_at  DateTime?

  game     Game?      @relation(fields: [game_id], references: [id], onDelete: Cascade)
  team     Team?      @relation(fields: [team_id], references: [id], onDelete: Cascade)
  uploader Player?    @relation("SubmissionUploader", fields: [player_id], references: [id], onDelete: SetNull)
  reviewer Organizer? @relation("SubmissionReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@map("submissions")
}
