# ggBoard backend environment — EXAMPLE (safe to commit)
# Copy to .env and fill in real values:  cp .env.example .env

# Server
PORT=3001
NODE_ENV=development

# Security — REQUIRED. The server refuses to start without it.
# Generate a strong value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# CORS — frontend origin allowed to call the API
FRONTEND_URL=http://localhost:5173

# Database (path relative to backend/)
DB_PATH=./database/ggboard.db
