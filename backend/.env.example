# ggBoard backend environment — EXAMPLE (safe to commit)
# Copy to .env and fill in real values:  cp .env.example .env

# Server
PORT=3001
NODE_ENV=development

# Security — REQUIRED. The server refuses to start without it.
# Generate a strong value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# CORS — frontend origin allowed to call the API
FRONTEND_URL=http://localhost:5173

# Database — Supabase Postgres (Prisma). Get these from the Supabase dashboard:
#   Connect → ORMs → Prisma  (Transaction pooler for DATABASE_URL, direct for DIRECT_URL)
# DATABASE_URL is the transaction pooler (port 6543, ?pgbouncer=true) used at runtime.
# DIRECT_URL is the direct connection (port 5432) used only by Prisma CLI migrations.
DATABASE_URL="postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
